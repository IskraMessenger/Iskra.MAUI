<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TorgLink.Maui"
             x:Class="TorgLink.Maui.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,24">
            <local:AppHeaderView x:Name="Header" />
            <Grid Padding="12,0,16,2" ColumnDefinitions="36,*" ColumnSpacing="4">
                <Button Text="&#x2039;" FontSize="28" BackgroundColor="Transparent"
                        TextColor="{DynamicResource MidnightBlue}" Padding="0" Clicked="OnBackClicked" />
                <Label x:Name="TitleLabel" Grid.Column="1" FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource MidnightBlue}" VerticalOptions="Center" />
            </Grid>
            <Grid Padding="16,8,16,16" ColumnDefinitions="56,*,Auto" ColumnSpacing="12" x:Name="ProfileRow">
                <Grid WidthRequest="52" HeightRequest="52">
                    <Border x:Name="ProfileAvatar" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" BackgroundColor="{DynamicResource Accent}" />
                    <Label x:Name="ProfileInitials" TextColor="White" FontAttributes="Bold" FontSize="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image x:Name="ProfileAvatarImage" WidthRequest="52" HeightRequest="52" Aspect="AspectFill"
                           IsVisible="False" />
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="ProfileName" FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="ProfileId" FontSize="12" TextColor="{DynamicResource MutedText}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
            <Label x:Name="LanguageSectionLabel" FontSize="13" TextColor="{DynamicResource MutedText}"
                   Margin="16,16,16,8" />
            <Grid x:Name="LanguageTiles" Padding="16,0,16,8" ColumnSpacing="10" RowSpacing="10"
                  ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" />
            <Label x:Name="LanguageWarningLabel" FontSize="12" TextColor="#FF9500"
                   Margin="16,0,16,12" IsVisible="False" LineBreakMode="WordWrap" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
            <Label x:Name="AppearanceLabel" FontSize="13" TextColor="{DynamicResource MutedText}"
                   Margin="16,16,16,8" />
            <HorizontalStackLayout x:Name="ThemeChips" Spacing="10" Padding="16,0,16,12" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="BluetoothLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="BluetoothHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="BluetoothSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}"
                        Toggled="OnBluetoothToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <Label x:Name="UdpLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}"
                       VerticalOptions="Center" />
                <Label x:Name="UdpPortLabel" Grid.Column="1" FontSize="15" TextColor="{DynamicResource MutedText}"
                       VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="LanLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="LanHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="LanSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnLanToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="RoutingLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="RoutingHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="RoutingSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}"
                        Toggled="OnRoutingToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="DatabaseLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="DatabaseHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Picker x:Name="DatabasePicker" Grid.Column="1" WidthRequest="150" SelectedIndexChanged="OnDatabaseProviderChanged"
                        BackgroundColor="{DynamicResource PageBackground}" TextColor="{DynamicResource MidnightBlue}" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <VerticalStackLayout Padding="16,12" Spacing="8">
                <Label x:Name="EconomyLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                <Label x:Name="EconomyHint" FontSize="12" TextColor="{DynamicResource MutedText}"
                       LineBreakMode="WordWrap" />
                <FlexLayout x:Name="EconomyChips" Wrap="Wrap" Direction="Row" AlignItems="Start"
                            JustifyContent="Start" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <Label x:Name="StorageTitleLabel" FontSize="16" TextColor="{DynamicResource MidnightBlue}"
                       VerticalOptions="Center" />
                <Label x:Name="StorageLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource MutedText}"
                       VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="ExportKeysButton" Clicked="OnExportKeysClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="RoutingOpenButton" Clicked="OnOpenRoutingClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="ConnectionTestButton" Clicked="OnConnectionTestClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="BlacklistButton" Clicked="OnBlacklistClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="LogsButton" Clicked="OnLogsClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="AboutButton" Clicked="OnAboutClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button x:Name="LogoutButton" Clicked="OnLogoutClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource Danger}"
                    HorizontalOptions="Fill" Padding="16,14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
