<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TorgLink.Maui.AppHeaderView">
    <Grid Padding="16,10,16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Image Source="logo_transparent_min.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"
                   VerticalOptions="Center" />
            <Label Text="TorgLink"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource MidnightBlue}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="Start">
            <Ellipse x:Name="MeshDot" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
            <Label x:Name="MeshLabel" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Ellipse x:Name="ServerDot" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
            <Label x:Name="ServerLabel" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Image x:Name="BtIcon" Source="icon_bluetooth.png" WidthRequest="16" HeightRequest="16"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
            <Grid x:Name="SelfAvatarHost" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                <Border x:Name="SelfAvatarFill" WidthRequest="28" HeightRequest="28" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource Accent}" />
                <Label x:Name="SelfAvatarInitials" TextColor="White" FontAttributes="Bold" FontSize="10"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Image x:Name="SelfAvatarImage" WidthRequest="28" HeightRequest="28" Aspect="AspectFill"
                       IsVisible="False" />
            </Grid>
            <Label x:Name="NickLabel" FontSize="12" FontAttributes="Bold"
                   TextColor="{DynamicResource MidnightBlue}" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" MaximumWidthRequest="140" />
            <Label x:Name="PortLabel" FontSize="12" TextColor="{DynamicResource MutedText}"
                   VerticalOptions="Center" />
            <Path x:Name="SettingsIcon"
                  Data="M19.4 13a7.7 7.7 0 0 0 .1-1 7.7 7.7 0 0 0-.1-1l2-1.6-2-3.4-2.4 1a7.4 7.4 0 0 0-1.7-1L15 3H9l-.3 2.9a7.4 7.4 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7.7 7.7 0 0 0-.1 1 7.7 7.7 0 0 0 .1 1l-2 1.6 2 3.4 2.4-1a7.4 7.4 0 0 0 1.7 1L9 21h6l.3-2.9a7.4 7.4 0 0 0 1.7-1l2.4 1 2-3.4-2-1.6zM12 15.5A3.5 3.5 0 1 1 15.5 12 3.5 3.5 0 0 1 12 15.5z"
                  Fill="{DynamicResource MidnightBlue}"
                  Aspect="Uniform"
                  WidthRequest="44" HeightRequest="44"
                  VerticalOptions="Center" Margin="2,0,0,0" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
