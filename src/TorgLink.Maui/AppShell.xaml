<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="TorgLink.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="TorgLink"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab x:Name="ChatsTab" Title="Chats" Icon="tab_chats.png">
            <ShellContent x:Name="ChatsHost" Title="Chats" />
        </Tab>
        <Tab x:Name="ContactsTab" Title="Contacts" Icon="tab_contacts.png">
            <ShellContent x:Name="ContactsHost" Title="Contacts" />
        </Tab>
        <Tab x:Name="NetworkTab" Title="Network" Icon="tab_network.png">
            <ShellContent x:Name="NetworkHost" Title="Network" />
        </Tab>
    </TabBar>
</Shell>
