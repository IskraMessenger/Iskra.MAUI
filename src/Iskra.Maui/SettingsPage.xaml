<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Iskra.Maui"
             x:Class="Iskra.Maui.SettingsPage"
             Title="Настройки"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,24">
            <local:AppHeaderView x:Name="Header" />
            <Grid Padding="16,8,16,16" ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                <Grid WidthRequest="52" HeightRequest="52">
                    <Border x:Name="ProfileAvatar" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" BackgroundColor="{DynamicResource Accent}" />
                    <Label x:Name="ProfileInitials" TextColor="White" FontAttributes="Bold" FontSize="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="ProfileName" FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="ProfileId" FontSize="12" TextColor="{DynamicResource MutedText}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
            <Label Text="Оформление" FontSize="13" TextColor="{DynamicResource MutedText}"
                   Margin="16,16,16,8" />
            <HorizontalStackLayout x:Name="ThemeChips" Spacing="10" Padding="16,0,16,12" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Bluetooth" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="BluetoothHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="BluetoothSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}"
                        Toggled="OnBluetoothToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <Label Text="UDP (локальный порт)" FontSize="16" TextColor="{DynamicResource MidnightBlue}"
                       VerticalOptions="Center" />
                <Label x:Name="UdpPortLabel" Grid.Column="1" FontSize="15" TextColor="{DynamicResource MutedText}"
                       VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="LAN-сканирование" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="LanHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="LanSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnLanToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="P2P-маршрутизация" FontSize="16" TextColor="{DynamicResource MidnightBlue}" />
                    <Label x:Name="RoutingHint" FontSize="12" TextColor="{DynamicResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="RoutingSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}"
                        Toggled="OnRoutingToggled" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <Label Text="Хранилище" FontSize="16" TextColor="{DynamicResource MidnightBlue}" VerticalOptions="Center" />
                <Label x:Name="StorageLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource MutedText}"
                       VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="Экспорт ключей" Clicked="OnExportKeysClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="P2P-маршрутизация…" Clicked="OnOpenRoutingClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="Тест соединения" Clicked="OnConnectionTestClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="Журнал" Clicked="OnLogsClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="О приложении" Clicked="OnAboutClicked" BackgroundColor="Transparent"
                    TextColor="{DynamicResource MidnightBlue}" HorizontalOptions="Fill" Padding="16,14" />
            <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" Margin="16,0" />
            <Button Text="Выйти" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="{DynamicResource Danger}"
                    HorizontalOptions="Fill" Padding="16,14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
