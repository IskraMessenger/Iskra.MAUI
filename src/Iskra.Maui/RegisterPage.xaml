<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Iskra.Maui.RegisterPage"
             Title="Register"
             BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="28,36" Spacing="16" MaximumWidthRequest="420" HorizontalOptions="Center">
            <Image Source="logo_min.png" WidthRequest="64" HeightRequest="64" Aspect="AspectFit"
                   HorizontalOptions="Center" />
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold"
                   TextColor="{DynamicResource MidnightBlue}" />
            <Label x:Name="SubtitleLabel" FontSize="14" TextColor="{DynamicResource MutedText}" />
            <Entry x:Name="NicknameEntry" />
            <Entry x:Name="PasswordEntry" IsPassword="True" TextChanged="OnPasswordTextChanged" />
            <Label x:Name="PasswordHintLabel"
                   FontSize="12" TextColor="{DynamicResource MutedText}" LineBreakMode="WordWrap" />
            <Button x:Name="RegisterButton" Clicked="OnRegisterClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
