<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Iskra.Maui.AddChatPage"
             Title="Add P2P chat">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="CancelToolbar" Clicked="OnCancelClicked" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="NickLabel" />
            <Entry x:Name="PeerNickEntry" />
            <Label x:Name="IdLabel" />
            <Entry x:Name="PeerIdEntry" />
            <Label x:Name="PubKeyLabel" />
            <Editor x:Name="PeerPubKeyEditor" AutoSize="TextChanges" MinimumHeightRequest="120" />
            <Label x:Name="HostLabel" />
            <Entry x:Name="PeerHostEntry" Text="127.0.0.1" />
            <Label x:Name="PortLabel" />
            <Entry x:Name="PeerPortEntry" Text="17201" Keyboard="Numeric" />
            <Button x:Name="ScanCamButton" Clicked="OnScanQrCameraClicked" />
            <Button x:Name="ScanImgButton" Clicked="OnScanQrClicked" />
            <Button x:Name="SaveButton" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
