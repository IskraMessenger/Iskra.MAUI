<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Iskra.Maui"
             x:Class="Iskra.Maui.ContactsPage"
             Title="Контакты"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,*">
        <local:AppHeaderView x:Name="Header" />

        <VerticalStackLayout Grid.Row="1" Padding="16,4,16,10" Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Stroke="{DynamicResource Hairline}" StrokeThickness="1"
                        BackgroundColor="{DynamicResource FieldBackground}"
                        StrokeShape="RoundRectangle 18" Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#x1F50D;" FontSize="14" VerticalOptions="Center"
                               TextColor="{DynamicResource MutedText}" />
                        <Entry x:Name="SearchEntry" Grid.Column="1"
                               PlaceholderColor="{DynamicResource MutedText}" BackgroundColor="Transparent"
                               FontSize="15" TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>
                <Button x:Name="ScanButton" Grid.Column="1" FontSize="14" FontAttributes="Bold"
                        CornerRadius="24" HeightRequest="48" Padding="16,0"
                        BackgroundColor="{DynamicResource Accent}" TextColor="{DynamicResource ButtonText}"
                        Clicked="OnScanClicked" />
            </Grid>
            <HorizontalStackLayout x:Name="ScanStatusRow" IsVisible="False" Spacing="8">
                <ActivityIndicator x:Name="ScanSpinner" WidthRequest="16" HeightRequest="16"
                                   Color="{DynamicResource Accent}" />
                <Label x:Name="ScanStatusLabel" FontSize="12" TextColor="{DynamicResource MutedText}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="ContactsCollection" Grid.Row="2" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyContactsLabel"
                       TextColor="{DynamicResource MutedText}" HorizontalOptions="Center"
                       VerticalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16,10" ColumnDefinitions="52,*" ColumnSpacing="12"
                          Loaded="OnContactRowLoaded">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContactRowTapped" />
                        </Grid.GestureRecognizers>
                        <Grid WidthRequest="48" HeightRequest="48">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24" BackgroundColor="{Binding AvatarColor}" />
                            <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Ellipse WidthRequest="12" HeightRequest="12" Fill="#34C759"
                                     HorizontalOptions="End" VerticalOptions="End" Stroke="White" StrokeThickness="2"
                                     IsVisible="{Binding IsOnline}" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource MidnightBlue}" />
                            <Label Text="{Binding Detail}" FontSize="12" TextColor="{DynamicResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
