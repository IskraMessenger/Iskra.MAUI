<Project>
    <PropertyGroup>
        <NetCoreTargetFramework>net10.0</NetCoreTargetFramework>
        <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>

        <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_SDK_ROOT)' != '' and Exists('$(ANDROID_SDK_ROOT)')">$(ANDROID_SDK_ROOT)</AndroidSdkDirectory>
        <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' != '' and Exists('$(ANDROID_HOME)')">$(ANDROID_HOME)</AndroidSdkDirectory>
        <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>

        <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and '$(JAVA_HOME)' != '' and $([MSBuild]::IsOSPlatform('windows')) and Exists('$(JAVA_HOME)\bin\jar.exe')">$(JAVA_HOME)</JavaSdkDirectory>
        <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and '$(JAVA_HOME)' != '' and !$([MSBuild]::IsOSPlatform('windows')) and Exists('$(JAVA_HOME)/bin/jar')">$(JAVA_HOME)</JavaSdkDirectory>

        <ShortP2PHasAndroidSdk Condition="'$(ShortP2PHasAndroidSdk)' == '' and '$(AndroidSdkDirectory)' != '' and Exists('$(AndroidSdkDirectory)\platforms')">true</ShortP2PHasAndroidSdk>
        <ShortP2PHasAndroidSdk Condition="'$(ShortP2PHasAndroidSdk)' == '' and '$(AndroidSdkDirectory)' != '' and Exists('$(AndroidSdkDirectory)\platform-tools')">true</ShortP2PHasAndroidSdk>
        <ShortP2PHasAndroidSdk Condition="'$(ShortP2PHasAndroidSdk)' == ''">false</ShortP2PHasAndroidSdk>

        <!-- Windows is the default TFM so `dotnet run` / IDE F5 can start the desktop app.
             Android is opt-in: -p:IncludeAndroid=true -->
        <ShortP2PBuildAndroid Condition="'$(IncludeAndroid)' == 'true'">true</ShortP2PBuildAndroid>
        <ShortP2PBuildAndroid Condition="'$(ShortP2PBuildAndroid)' == ''">false</ShortP2PBuildAndroid>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Update="SQLitePCLRaw.lib.e_sqlite3">
            <ExcludeAssets>native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
